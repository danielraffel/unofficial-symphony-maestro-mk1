class SymphonyThunderbridge;
class LOCALONLY SymphonyInputTypeControl : public IOUserAudioSelectorControl
{
public:
    virtual bool init(IOUserAudioDriver*, bool, IOUserAudioObjectPropertyElement, IOUserAudioObjectPropertyScope, IOUserAudioClassID) override;
    virtual void free() override;
