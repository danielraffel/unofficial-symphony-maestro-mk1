<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for this LaunchDaemon -->
    <key>Label</key>
    <string>com.danielraffel.Maestro.volumeproxy</string>

    <!-- The proxy binary installed by install.sh -->
    <key>Program</key>
    <string>/usr/local/bin/MaestroVolumeProxy</string>

    <!--
        MachServices tells launchd to register the Mach port under this name,
        making it visible to xpc_connection_create_mach_service() callers.
        The AudioServerPlugin sandbox allows mach-lookup broadly, so the
        sandboxed helper can reach this service even though UNIX sockets are blocked.
    -->
    <key>MachServices</key>
    <dict>
        <key>com.danielraffel.Maestro.volumeproxy</key>
        <true/>
    </dict>

    <!-- Start immediately when loaded and restart if it exits -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!--
        Enables the periodic render diagnostic, which is the health check for the
        audio bridge:

          render #N: frames=512 depth=1280 minHeadroom=812 D=1280 late=0
                     rateScalar=1.000021 gen=1 data_cb=...

        minHeadroom is the one to watch. It is the worst gap, over the interval,
        between the plugin's write head and the last frame this callback needed.
        It must stay >= 0 while audio is playing; negative means we read a slot
        before it was written, which is audible as a lap-old splice rather than
        silence. depth should sit flat near D; under the old open-loop FIFO it
        wandered the full 32768-frame ring and pegged for over an hour at a time.

        Remove this key to silence it in normal use.

        This flag is deliberately NOT the one that controls per-XPC-message
        logging. That is MAESTRO_PROXY_TRACE, and it is absent here on purpose:
        the app polls meters and properties at roughly 60 Hz for as long as its
        window is open, so tracing every message wrote about 1 MB a minute
        forever and was ~95% of a 437 MB log file. Add MAESTRO_PROXY_TRACE only
        while actually chasing an XPC problem, and take it out afterwards.

        The proxy caps this file at 64 MB itself (launchd never rotates it), so a
        forgotten trace flag costs disk churn rather than a full volume.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>MAESTRO_PROXY_DEBUG</key>
        <string>1</string>
    </dict>

    <!-- Logs for debugging: tail -f /tmp/MaestroVolumeProxy.log -->
    <key>StandardOutPath</key>
    <string>/tmp/MaestroVolumeProxy.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/MaestroVolumeProxy.log</string>
</dict>
</plist>
