# Copy outside the checkout, chmod 600, and set MAESTRO_ENV_FILE to its path.
# Private keys/profiles are never committed. Bundle IDs in source must match
# your registered identifiers and approved entitlement profiles.
TEAM_ID=YOUR_APPLE_TEAM_ID
SIGNING_IDENTITY=YOUR_DEVELOPER_ID_APPLICATION_CERTIFICATE_SHA1
INSTALLER_IDENTITY=YOUR_DEVELOPER_ID_INSTALLER_CERTIFICATE_SHA1
SIGNING_KEYCHAIN=/absolute/path/to/your/unlocked-signing.keychain-db
MAESTRO_APP_PROFILE=/absolute/path/to/your/app.provisionprofile
MAESTRO_DEXT_PROFILE=/absolute/path/to/your/thunderbridge.provisionprofile
NOTARY_PROFILE=your-notarytool-keychain-profile
# Or set all three instead of NOTARY_PROFILE:
# NOTARY_KEY_PATH=/absolute/path/to/AuthKey.p8
# NOTARY_KEY_ID=YOUR_KEY_ID
# NOTARY_ISSUER_ID=YOUR_ISSUER_ID
MAESTRO_BUILD_JOBS=4
# Only for signing private test feeds/packages; never used by ordinary builds.
# SPARKLE_ED_KEY_FILE=/absolute/path/to/your/ed25519-private-key
