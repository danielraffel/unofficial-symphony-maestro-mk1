#!/bin/bash
# Postinstall — optional USB support (AudioServerPlugin + MaestroVolumeProxy).
#
# Only needed for a USB-connected Symphony I/O. On macOS 26 Apple replaced
# AppleUSBAudio.kext with usbaudiod, which takes exclusive ownership of USB audio
# interfaces; the AudioServerPlugin publishes a virtual device so the volume keys and
# Sound settings slider have something to drive, and MaestroVolumeProxy (a root
# LaunchDaemon) sends the USB EP0 vendor commands.
#
# A Thunderbolt-only machine needs none of this.
set -euo pipefail
LOG="/tmp/maestro-installer.log"
PLUGIN_PATH="/Library/Audio/Plug-Ins/HAL/ApogeeSymIO.driver"
PLUGIN_FINGERPRINT="/var/run/maestro-installer-usb-fingerprint"
PROXY_PATH="/usr/local/bin/MaestroVolumeProxy"
PROXY_PLIST="${PROXY_PLIST:-/Library/LaunchDaemons/com.danielraffel.Maestro.volumeproxy.plist}"

usb_component_fingerprint() {
    local path
    for path in "$PLUGIN_PATH" "$PROXY_PATH" "$PROXY_PLIST"; do
        if [ -d "$path" ]; then
            /usr/bin/find "$path" -type f -exec /usr/bin/shasum -a 256 {} \; 2>/dev/null
        elif [ -f "$path" ]; then
            /usr/bin/shasum -a 256 "$path"
        fi
    done | /usr/bin/sort | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
}

usb_components_changed() {
    local current previous
    current="$(usb_component_fingerprint 2>/dev/null || true)"
    previous="$(/bin/cat "$PLUGIN_FINGERPRINT" 2>/dev/null || true)"
    [ -n "$current" ] && [ "$current" != "$previous" ]
}

ensure_proxy_running() {
    if launchctl print "system/$PROXY_LABEL" > /dev/null 2>&1; then
        return 0
    fi

    launchctl bootstrap system "$PROXY_PLIST" 2>/dev/null || {
        sleep 2
        launchctl bootstrap system "$PROXY_PLIST" 2>/dev/null || true
    }
    echo "[postinstall/usb] MaestroVolumeProxy bootstrapped" >> "$LOG"
}

main() {
echo "[postinstall/usb] $(date '+%Y-%m-%d %H:%M:%S') start" >> "$LOG"

# The core postinstall reopens Maestro once this script has finished, so that
# Maestro starts after coreaudiod is back. It waits while this marker exists.
# /var/run is root-only. Removed on every exit, including a failure.
USB_MARKER_DEFAULT="/var/run/maestro-usb-postinstall.running"
USB_MARKER="${USB_MARKER:-$USB_MARKER_DEFAULT}"
/usr/bin/touch "$USB_MARKER"
trap '/bin/rm -f "$USB_MARKER"' EXIT

chown -R root:wheel /Library/Audio/Plug-Ins/HAL/ApogeeSymIO.driver 2>/dev/null || true
chown root:wheel /usr/local/bin/MaestroVolumeProxy 2>/dev/null || true
chmod 755 /usr/local/bin/MaestroVolumeProxy 2>/dev/null || true
chown root:wheel /Library/LaunchDaemons/com.danielraffel.Maestro.volumeproxy.plist 2>/dev/null || true
chmod 644 /Library/LaunchDaemons/com.danielraffel.Maestro.volumeproxy.plist 2>/dev/null || true

PROXY_LABEL="com.danielraffel.Maestro.volumeproxy"
PROXY_PLIST="${PROXY_PLIST:-/Library/LaunchDaemons/${PROXY_LABEL}.plist}"

# Restart both the helper and Core Audio when any USB component is new or
# changed, so the paired processes attach to the same generation. The old
# fingerprint was captured by preinstall before Installer replaced the payload.
#
# 0.8.36 skipped this when the plug-in's code was unchanged, to avoid a long
# audio stall seen once with a ThunderBridge attached. That left the running
# plug-in paired with a freshly restarted helper, and on the first USB session
# afterwards every block sent to "Maestro USB" was dropped as late: no sound
# through the virtual device until coreaudiod was restarted (2026-11-13). The
# stall is the lesser problem when the plug-in really changed.
if usb_components_changed; then
    launchctl bootout "system/$PROXY_LABEL" 2>/dev/null || true
    sleep 1
    ensure_proxy_running
    killall coreaudiod 2>/dev/null || true
    sleep 3
    echo "[postinstall/usb] $(date '+%Y-%m-%d %H:%M:%S') helper and coreaudiod restarted (USB component changed)" >> "$LOG"
else
    # Core preinstall boots the helper out before every install. Keep it running
    # even when the payload fingerprint is unchanged, while avoiding the costly
    # Core Audio restart that the unchanged path is meant to skip.
    ensure_proxy_running
    echo "[postinstall/usb] $(date '+%Y-%m-%d %H:%M:%S') helper and coreaudiod restart skipped (USB components unchanged)" >> "$LOG"
fi
/bin/rm -f "$PLUGIN_FINGERPRINT"
/bin/rm -f "$USB_MARKER"
echo "[postinstall/usb] $(date '+%Y-%m-%d %H:%M:%S') done" >> "$LOG"
exit 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
